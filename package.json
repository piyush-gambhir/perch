{
  "name": "perch-extension",
  "version": "1.1.0",
  "private": true,
  "description": "Perch — New tab page that groups your open tabs by domain and lets you close them with style.",
  "author": "Piyush Gambhir",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "build": "pnpm run generate:icons && wxt build",
    "build:local": "pnpm run build && node ./tools/publish-local.mjs",
    "build:firefox": "pnpm run generate:icons && wxt build -b firefox",
    "compile": "tsc --noEmit",
    "dev": "wxt --host 127.0.0.1 --port 3000",
    "dev:firefox": "wxt -b firefox --host 127.0.0.1 --port 3000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:icons": "node ./tools/generate-icons.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "wxt prepare",
    "test": "pnpm run typecheck && vitest run",
    "typecheck": "tsc --noEmit",
    "zip": "pnpm run generate:icons && wxt zip",
    "zip:firefox": "pnpm run generate:icons && wxt zip -b firefox"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  }
}
