{
  "name": "perch-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Perch — New tab page that groups your open tabs by domain and lets you close them with style.",
  "author": "Piyush Gambhir",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "pnpm run generate:icons && wxt build",
    "build:firefox": "pnpm run generate:icons && wxt build -b firefox",
    "compile": "tsc --noEmit",
    "dev": "wxt --host 127.0.0.1 --port 3000",
    "dev:firefox": "wxt -b firefox --host 127.0.0.1 --port 3000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:icons": "node ./tools/generate-icons.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "wxt prepare",
    "test": "pnpm run typecheck && vitest run",
    "typecheck": "tsc --noEmit",
    "zip": "pnpm run generate:icons && wxt zip",
    "zip:firefox": "pnpm run generate:icons && wxt zip -b firefox",
    "cws:upload": "pnpm zip && pnpm dlx chrome-webstore-upload-cli@3 upload --source .output/perch-extension-$npm_package_version-chrome.zip",
    "cws:publish": "pnpm dlx chrome-webstore-upload-cli@3 publish --target trustedTesters",
    "release:store": "pnpm run cws:upload && pnpm run cws:publish"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11",
    "wxt": "^0.20.27"
  }
}
